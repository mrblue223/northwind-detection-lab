// Detection: Process accesses LSASS memory (classic credential dumping)
// ATT&CK: T1003.001 OS Credential Dumping: LSASS Memory
// Data source: Sysmon Event ID 10 (Process Access)
// Severity: Critical
// Known false positives: legitimate security tooling, Task Manager with
// admin rights, Windows Defender itself. Exclude known-good SourceImage
// paths (e.g. MsMpEng.exe) once a baseline exists.

Event
| where EventID == 10 // Sysmon: Process Access
| where Source == "Microsoft-Windows-Sysmon"
| extend TargetImage = tostring(parse_xml(EventData).DataItem.EventData.Data[6]["#text"])
| extend SourceImage = tostring(parse_xml(EventData).DataItem.EventData.Data[4]["#text"])
| extend GrantedAccess = tostring(parse_xml(EventData).DataItem.EventData.Data[10]["#text"])
| where TargetImage has "lsass.exe"
| where SourceImage !has_any ("MsMpEng.exe", "Taskmgr.exe")
| project TimeGenerated, Computer, SourceImage, TargetImage, GrantedAccess
| order by TimeGenerated desc
